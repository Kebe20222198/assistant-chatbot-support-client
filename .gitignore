# ═══════════════════════════════════════════════════════════════
#  assistant-chatbot-support-client — .gitignore
# ═══════════════════════════════════════════════════════════════

# ── Secrets ──────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
venv/
.venv/
env/
.Python

# ── Node / Next.js ──────────────────────────────────────────
node_modules/
.next/
out/
frontend/.next/
frontend/node_modules/

# ── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Docker ───────────────────────────────────────────────────
docker-compose.override.yml

# ── Qdrant local data ───────────────────────────────────────
qdrant_data/
qdrant_storage/

# ── HuggingFace model cache (can be large) ──────────────────
.cache/
models/

# ── Pytest / Coverage ───────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Data Scraped / Ingestion ────────────────────────────────
backend/data/
